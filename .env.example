# SecureVista — backend environment configuration
#
# Copy this file to .env and fill in your own values:
#     cp .env.example .env
#
# .env is gitignored. Never commit real credentials.
# The Telegram bot reads its own file — see telegram_bot/.env.example.


# ─── Twilio voice escalation ────────────────────────────────────────────
# Account SID and auth token from https://console.twilio.com
# Leave both blank to disable outbound calls; the rest of the system
# keeps running and simply skips the phone escalation step.
TWILIO_SID=
TWILIO_TOKEN=

# The Twilio number calls are placed from (must be one you own).
TWILIO_FROM=+10000000000


# ─── Alert routing ──────────────────────────────────────────────────────
# Guard on call. Receives voice escalations and WhatsApp alerts.
GUARD_PHONE=+910000000000

# Gmail address and a 16-character Google App Password — NOT your normal
# account password. Used by survilleance/Email_Alert.py for snapshot mail.
EMAIL_ADDRESS=
EMAIL_PASS=


# ─── Fire and smoke detection (optional) ────────────────────────────────
# Trained YOLO checkpoints. They are ~84 MB so they are not committed;
# drop them in weights/ or point these at wherever you keep them.
# If the files are absent, hazard detection switches itself off and the
# rest of the pipeline runs normally.
FIRE_WEIGHTS=weights/trained_fire_dataset_V2.1.pt
SMOKE_WEIGHTS=weights/[25_epochs]trained_smoke_V1.1.pt


# ─── Voice Sentinel service (optional) ──────────────────────────────────
# Standalone alert-generation service, started via voice_sentinel_server.py.
# If it is unreachable the backend falls back to generating the spoken
# alert in-process, so running it is optional.
VOICE_SENTINEL_URL=http://localhost:5003/api/voice/alert

# Publicly reachable base URL that Twilio hits for DTMF keypress and call
# status callbacks. For local testing expose it with a tunnel, e.g. ngrok,
# and put the https URL here — localhost will not work for callbacks.
WEBHOOK_BASE_URL=http://localhost:5003
